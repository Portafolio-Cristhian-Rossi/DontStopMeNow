{
  "expo": {
    "name": "DontStopMeNow",
    "slug": "dontstopmenow",
    "scheme": "dontstopmenow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.cristhianrossi.dontstopmenow",
      "permissions": ["CHANGE_WIFI_MULTICAST_STATE", "ACCESS_WIFI_STATE", "POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para escanear el código QR del servidor.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
